# Required
TELEGRAM_TOKEN=
ALLOWED_USER_ID=
ROUTER9_API_KEY=
DATABASE_URL=
SETTINGS_ENC_KEY=

# Required for webhook deployment
WEBHOOK_SECRET=
WEBHOOK_BASE_URL=
# Địa chỉ web công khai cho link canonical/og:url/sitemap.xml (tên miền riêng); trống = WEBHOOK_BASE_URL
# SITE_BASE_URL=
# Tra tên địa điểm cho vị trí hiện tại ở /thoi-tiet qua OpenStreetMap Nominatim (0 = tắt)
# NOMINATIM_ENABLED=1
# Mã xác minh Google Search Console (cách "Thẻ HTML"): dán phần content hoặc cả thẻ meta
# GOOGLE_SITE_VERIFICATION=

# Provider fallback (9Router -> Groq -> OpenRouter -> API1 -> API2, tất cả miễn phí)
ROUTER9_BASE_URL=
ROUTER9_MODEL=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.6-27b
# Model Groq TỰ tra web (tool browser_search, chỉ openai/gpt-oss-*). groq/compound-mini
# cũ đã bị Groq khai tử 21/09/2026 - còn để giá trị đó thì bot tự đổi về gpt-oss-120b.
GROQ_REALTIME_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_VISION_MODEL=google/gemma-4-26b-a4b-it:free

# Provider tự tra web khi Tavily tắt/lỗi/ít nguồn (và cho câu giá vàng, tỷ giá...):
# Gemini (API 1/2) luôn dùng Google Search grounding; Groq dùng browser_search.
GROQ_WEB_SEARCH=1
# OpenRouter: plugin web TỐN CREDIT kể cả model :free - chỉ bật khi đã nạp credit.
OPENROUTER_WEB_SEARCH=0
# 9Router: thử web_search_options, chỉ tin khi có annotations url_citation.
ROUTER9_WEB_SEARCH=0
ROUTER9_WEB_SEARCH_MODEL=
# Lọc link lạ trong câu trả lời: untrusted (lượt có dữ liệu web ngoài) | all | off
REPLY_URL_FILTER=untrusted

# Agnes AI (tạo ảnh thật, lệnh /anh - bật/tắt qua /anh on|off)
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_IMAGE_MODEL=agnes-image-2.1-flash
AGNES_CALL_TIMEOUT_SEC=90

# vnstock API key MIỄN PHÍ (đăng ký tại https://vnstocks.com/login) - tùy
# chọn, không set thì vnstock vẫn chạy ở mức Guest (20 req/phút)
VNSTOCK_API_KEY=

# Tavily web search (grounding cho chat, bật/tắt qua lệnh /tavily on|off)
TAVILY_API_KEY=

GOOGLE_AI_STUDIO_API_KEY_1=
GOOGLE_AI_STUDIO_API_KEY_2=
# Tên biến cũ của GOOGLE_AI_STUDIO_API_KEY_1 (chỉ dùng khi _1 trống).
# GOOGLE_AI_STUDIO_API_KEY=
GOOGLE_AI_STUDIO_MODEL=gemini-3.5-flash-lite
PROVIDER_ORDER=router9,groq,openrouter,api1,api2
# Ảnh (prompt từ ảnh, hỏi đáp ảnh, hoá đơn): ưu tiên provider chắc chắn đọc được ảnh.
VISION_PROVIDER_ORDER=api1,api2,openrouter,groq,router9

# Gemini Live (WebSocket, ai/live_client.py) - dùng chung key api1/api2, cooldown
# quota RIÊNG (live_api1/2). Hạn mức free tier của Live CHƯA được Google công bố:
# xem số thật tại https://aistudio.google.com/rate-limit; /status và /admin đếm số
# lượt Live đã gọi trong ngày quota (provider_calls).
# Live làm provider chat dự phòng CUỐI chuỗi (tự thêm "live" vào cuối PROVIDER_ORDER
# nếu chưa ghi; chỉ chat thường - không tra web/JSON/cổ phiếu). 0 = không dùng.
LIVE_CHAT_FALLBACK=1
LIVE_MODEL=gemini-3.8-live
# Số phiên Live cùng lúc (RAM/quota), trần giây 1 lượt, trần MB âm thanh 1 lượt.
LIVE_MAX_SESSIONS=1
LIVE_CALL_TIMEOUT_SEC=60
LIVE_MAX_AUDIO_MB=8
# Số tin lịch sử gần nhất gửi kèm lượt chat qua Live.
LIVE_HISTORY_MESSAGES=6

# Tinh chỉnh provider (mặc định ổn, chỉ đổi khi cần): base URL, timeout từng pha
# httpx (giây), số lượt song song mỗi provider, số kết quả Tavily, timeout Gemini.
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
TAVILY_BASE_URL=https://api.tavily.com
GROQ_CALL_TIMEOUT_SEC=30
OPENROUTER_CALL_TIMEOUT_SEC=30
TAVILY_CALL_TIMEOUT_SEC=20
TAVILY_MAX_RESULTS=5
GROQ_MAX_CONCURRENCY=4
OPENROUTER_MAX_CONCURRENCY=4
VNSTOCK_MAX_CONCURRENCY=3
GEMINI_API_CALL_TIMEOUT_SEC=90
GEMINI_API_VISION_TIMEOUT_SEC=120
GEMINI_API_UTILITY_TIMEOUT_SEC=45
GEMINI_API_STATUS_TIMEOUT_SEC=20
# Đọc link/RSS (web_reader): timeout, số ký tự giữ lại, số mục RSS tối đa.
WEB_READER_TIMEOUT_SEC=20
WEB_READER_MAX_CHARS=6000
RSS_READER_MAX_ITEMS=8
# Trần ký tự 1 lượt /dich.
TRANSLATE_MAX_CHARS=4000
# Chu kỳ kiểm tra "mọi provider đều chết" + watchdog (giây).
MONITOR_INTERVAL_SEC=300
# Trả heap rảnh về hệ điều hành (gc.collect + malloc_trim của glibc, core/memtrim.py):
# định kỳ mỗi N giây trong vòng giám sát (0 = tắt), và sau lượt trả lời/việc nặng
# (AFTER_WORK=0 = tắt; tối đa 1 lần mỗi MIN_GAP giây).
MEMORY_TRIM_INTERVAL_SEC=600
MEMORY_TRIM_AFTER_WORK=1
MEMORY_TRIM_MIN_GAP_SEC=30

# Diagnostics
DIAGNOSE_SECRET=

# Supabase chập chờn: trần thời gian mở kết nối DB (asyncpg mặc định 60s) và số
# giây fail nhanh sau khi DB mất kết nối cả khi đã reconnect (0 = tắt breaker).
DB_CONNECT_TIMEOUT_SEC=8
DB_BREAKER_OPEN_SEC=30
# Header HSTS cho web/admin (0 = tắt, vd tên miền riêng chưa có HTTPS).
SECURITY_HSTS=1

# Trang /admin (quản lý provider, xem usage)
ADMIN_USER=
ADMIN_PASS=
# Số proxy tin cậy nối IP vào X-Forwarded-For (Render = 1); header IP riêng do
# proxy ghi đè (vd true-client-ip) - chỉ đặt sau khi kiểm tra log production.
ADMIN_TRUSTED_PROXY_HOPS=1
ADMIN_CLIENT_IP_HEADER=
# Thời hạn 1 phiên đăng nhập /admin (giây).
ADMIN_SESSION_TTL_SEC=43200

# Provider lifecycle
# (Tên cũ: COOKIE_PROBE_INTERVAL_SEC / GEMINI_COOKIE_CALL_TIMEOUT_SEC vẫn được đọc
# khi 2 biến ROUTER9_* tương ứng để trống.)
# COOKIE_PROBE_INTERVAL_SEC=
# GEMINI_COOKIE_CALL_TIMEOUT_SEC=
ROUTER9_PROBE_INTERVAL_SEC=900
# Cooldown TỐI ĐA cho lỗi hết quota theo NGÀY; lỗi 429 theo phút dùng Retry-After
# của provider (30s..15 phút, mặc định 90s).
API_QUOTA_COOLDOWN_SEC=3600
ROUTER9_CALL_TIMEOUT_SEC=120
ROUTER9_STEP_DELAY_SEC=3
ROUTER9_MAX_CONCURRENCY=4

# Conversation and scheduler
CHAT_SKILL_PATH=chat_skill.yaml
TRANSLATE_REFERENCE_PATH=translate_reference.txt
# Số LƯỢT hỏi-đáp (mỗi lượt 2 dòng lịch sử) đưa vào prompt.
CHAT_HISTORY_TURNS=10
# Tin chat có link + câu hỏi: đọc trang (web_reader) làm ngữ cảnh. Chủ bot và
# admin Zalo mặc định; CHAT_READ_LINKS_MEMBERS=1 mở cho cả thành viên Zalo.
CHAT_READ_LINKS=1
CHAT_READ_LINKS_MEMBERS=0
# Chat thường tự tra kho rag/ (BM25 cục bộ, không tốn AI) khi khớp rất rõ - chỉ chủ bot/admin.
CHAT_AUTO_RAG=1
# Hỏi thăm chủ động ("mai anh đi phỏng vấn" -> tối mai em hỏi thăm): chủ bot qua
# Telegram mặc định bật (/hoithan off để tắt), thành viên Zalo tự /hoithan on.
# Quét mỗi PROACTIVE_TICK_SEC trong giờ hoạt động, hỏi từ PROACTIVE_FOLLOWUP_HOUR
# giờ ngày diễn ra, tối đa PROACTIVE_DAILY_CAP tin/ngày/người, bỏ qua nếu người đó
# vừa chat trong PROACTIVE_IDLE_MIN phút. 0 = tắt toàn bộ.
PROACTIVE_FOLLOWUPS=1
PROACTIVE_ACTIVE_HOURS=08:00-21:30
PROACTIVE_FOLLOWUP_HOUR=18
PROACTIVE_DAILY_CAP=2
PROACTIVE_IDLE_MIN=20
PROACTIVE_TICK_SEC=1800
# Gom thông báo chủ động + giờ yên lặng (services/notify_hub.py, /yenlang): tin cần
# quyết (nhắc việc, chạm stop/giá, bài FB chờ duyệt, cảnh báo 🚨) gửi ngay; tin
# NORMAL (hỏi thăm, sự kiện quyền báo trước, cảnh báo nhẹ, bản tin...) gom thành 1
# tin mỗi NOTIFY_BATCH_MINUTES phút, khi người dùng vừa nhắn bot hoặc lúc hết giờ
# yên lặng. Giờ yên lặng mặc định (giờ VN; off = không có), mỗi người đổi bằng
# /yenlang. Tối đa NOTIFY_QUEUE_MAX_PER_USER tin chờ/người (vượt thì bỏ tin cũ nhất).
# 0 = tắt hẳn, mọi nguồn gửi thẳng như trước.
NOTIFY_HUB_ENABLED=1
NOTIFY_BATCH_MINUTES=60
NOTIFY_QUIET_HOURS=22:30-06:30
NOTIFY_QUEUE_MAX_PER_USER=30
# Việc nền /viec + tác vụ định kỳ /lichtacvu (services/background_jobs.py,
# services/routines.py): chạy NGOÀI khoá lượt của người dùng nhưng vẫn chiếm 1 chỗ
# MAX_CONCURRENT_TURNS. Hạn chót mỗi việc BACKGROUND_JOB_TIMEOUT_SEC (60-1800 giây),
# tối đa BACKGROUND_JOBS_CONCURRENCY việc chạy cùng lúc toàn bot, mỗi người tối đa
# BACKGROUND_JOBS_MAX_PER_USER việc đang chờ/chạy. Thành viên Zalo: /viec mặc định
# dùng được (tính lượt nặng, 0 = tắt), tác vụ định kỳ mặc định tắt (1 = mở).
# ROUTINE_MAX_RUNS_PER_DAY: trần số lần chạy tác vụ định kỳ mỗi ngày toàn bot.
BACKGROUND_JOBS_ENABLED=1
BACKGROUND_JOB_TIMEOUT_SEC=600
BACKGROUND_JOBS_CONCURRENCY=1
BACKGROUND_JOBS_MAX_PER_USER=3
BACKGROUND_JOBS_MEMBERS=1
ROUTINES_ENABLED=1
ROUTINES_MEMBERS=0
ROUTINE_MAX_RUNS_PER_DAY=20
CHAT_SESSION_TIMEOUT_SEC=21600
REMINDER_CHECK_INTERVAL_SEC=30
ENABLE_DAILY_DIGEST=true
DAILY_DIGEST_HOUR_VN=8
# Digest danh mục mặc định bỏ qua cuối tuần/ngày lễ (giá vẫn là phiên trước); true để gửi cả ngày nghỉ.
DIGEST_ON_NON_TRADING_DAYS=false
# Bản tin RSS 8h (Zalo controller + Zoom, /bangtinsang); feed phân cách dấu phẩy,
# để trống = 6 feed mặc định trong core/config.py (VnExpress, CafeF, Vietstock...).
MORNING_NEWS_ENABLED=true
MORNING_NEWS_HOUR_VN=8
# MORNING_NEWS_RSS_FEEDS=
# Bản tin sáng cá nhân (/bantin on|off|<giờ>|xem): mặc định không ai nhận, mỗi
# người tự bật trên kênh của mình. Telegram chủ bot bật thì thay digest danh mục
# 8h; tin RSS trên Telegram tắt mặc định (/bantin tin on để nhận).
MORNING_BRIEF_ENABLED=true
# Giờ gửi mặc định khi bật (4-12, giờ VN); mỗi người đổi bằng /bantin <giờ>.
MORNING_BRIEF_DEFAULT_HOUR=7
# Tối đa số người dùng Zalo nhận bản tin, kể cả controller (0 = tắt bản tin trên Zalo).
MORNING_BRIEF_MAX_MEMBERS=20
# Zalo controller / Zoom đã bật bản tin thì bản tin RSS 8h gộp vào (1 tin/ngày).
MORNING_BRIEF_ABSORB_NEWS=true
# 1 câu chào do AI viết cho chủ bot (tốn 1 lượt AI/ngày).
MORNING_BRIEF_AI_INTRO=false
# Dòng tổng chi tiêu tháng này (chỉ hiện với người đã ghi khoản chi).
MORNING_BRIEF_EXPENSES=true
# Tin ngắn "cafe 45k", "đổ xăng 1tr2" được ghi chi tiêu bằng code (không tốn AI);
# false = chỉ ghi khi nói rõ "ghi chi tiêu ..." hoặc dùng /chitieu.
EXPENSE_CHAT_CAPTURE=true
# Hỏi tự nhiên thay cho lệnh (services/nl_commands.py): "xem tử vi 15/3/1990 9h30 nam",
# "provider đang chạy cái nào", "bật giọng nói", "em làm được gì"... bot tự chạy đúng lệnh
# (lệnh xoá/quản trị chỉ được CHỈ RA, không tự chạy). 0 = tắt hẳn, chỉ còn lệnh /.
NL_COMMANDS_ENABLED=1
# 1 = câu có dấu hiệu là yêu cầu chức năng mà code chưa nhận ra thì các lệnh của nhóm
# đó được thêm vào router tool (vẫn 1 lượt router như cũ); 0 = chỉ mẫu câu bằng code.
NL_COMMANDS_LLM=1
# Nhật ký ăn uống /an: kcal ước lượng tra bảng assets/thuc_pham.yaml (không AI).
# NUTRITION_NL=1: câu rất rõ "ghi ăn phở bò", "trưa nay anh ăn bún chả" cũng được ghi.
NUTRITION_NL=0
# 1 = món không có trong bảng được ước lượng kcal bằng 1 lượt AI JSON (có hạn chót).
NUTRITION_AI_ESTIMATE=0
# Lịch sử chat giữ tối đa N dòng mỗi người (xoay vòng, 200-2000) - đủ cho câu
# "hôm trước em nói gì về ..." (tool search_history) mà vẫn có trần trên Supabase.
CHAT_MESSAGES_RETENTION_LIMIT=1000

# Tin thoại, ảnh hỏi đáp, tài liệu (Telegram + Zalo qua /internal/zalo/voice|file)
# Tin thoại: Groq Whisper (GROQ_STT_MODEL, cùng GROQ_API_KEY, bucket rate-limit
# audio riêng), dự phòng Gemini nghe audio. Lượt từ tin thoại CHỈ ĐỌC: không ghi
# danh mục/chi tiêu/nhắc việc theo chữ nghe được. 0 = tắt.
VOICE_STT_ENABLED=1
GROQ_STT_MODEL=whisper-large-v3-turbo
# Ngôn ngữ gửi Whisper (vi); để trống hoặc "auto" = tự nhận ngôn ngữ.
VOICE_STT_LANGUAGE=vi
VOICE_MAX_BYTES=5242880
VOICE_MAX_SECONDS=180
# Trả lời kèm giọng nói (/noi on|off|auto, mỗi người tự bật; mặc định tắt). Gemini
# TTS bằng key AI Studio sẵn có; có ffmpeg trên PATH thì Telegram nhận tin thoại
# OGG, không có thì file WAV; Zalo CHỈ gửi được khi có ffmpeg (M4A); Zoom (chatbot
# không gửi được âm thanh) nhận 1 dòng link nghe - cần WEBHOOK_BASE_URL/RENDER_EXTERNAL_URL
# https. Chữ được chuẩn hoá trước khi đọc (số tiền, viết tắt, mã cổ phiếu - từ điển
# assets/tts_viet_tat.yaml). 0 = tắt cả bot.
VOICE_REPLY_ENABLED=1
# Số ký tự tối đa được đọc (dài hơn thì đọc đoạn đầu, nhắc xem phần chữ).
VOICE_REPLY_MAX_CHARS=600
VOICE_TTS_MODEL=gemini-3.8-flash-tts
# Giọng dựng sẵn mặc định của Gemini TTS (Sulafat ấm, Leda trẻ trung, Aoede, Vindemiatrix,
# Kore...) - Live dùng chung; mỗi người đổi riêng bằng /noi giong <tên>.
VOICE_TTS_VOICE=Sulafat
# Chỉ dẫn phong cách đọc bằng lời (TTS: annotation speech_metadata; Live: chỉ dẫn hệ
# thống). Trống = mặc định "giọng nữ trẻ miền Nam, ấm, thân mật, có ngắt nghỉ..."; off = tắt.
VOICE_STYLE_PROMPT=
# Bộ đọc: auto = Gemini Live trước, lỗi/hết quota/đọc lệch chữ thì Gemini TTS;
# live = chỉ Live (lỗi thì chỉ gửi chữ); tts = chỉ Gemini TTS.
VOICE_ENGINE=auto
# Live phải đọc giống bản chữ >= N% (so bản chép lời theo từ, bỏ dấu); thấp hơn thì
# bỏ âm thanh Live (auto: dùng TTS) để tin thoại không nói khác bản chữ.
LIVE_VOICE_MIN_MATCH=80
# Zalo/Zoom: link tin thoại ký HMAC sống N phút; kho RAM tối đa N MB (và 12 file).
VOICE_REPLY_URL_TTL_MIN=10
VOICE_REPLY_STORE_MB=4
# Ảnh kèm câu hỏi ("ảnh này là gì?", "dịch chữ trong ảnh") -> trả lời về ảnh;
# 0 = mọi ảnh đều viết prompt như cũ. Ảnh KHÔNG caption: prompt (mặc định) hoặc
# describe (mô tả ngắn + gợi ý gửi chữ "prompt").
VISION_QA_ENABLED=1
PHOTO_NO_CAPTION_MODE=prompt
# Đọc file PDF/TXT/MD/DOCX gửi trong chat (tóm tắt hoặc trả lời câu hỏi kèm theo);
# chủ bot gửi kèm chữ "lưu vào kho" để lưu vào rag/tailieu/ (đồng bộ bằng GITHUB_RAG_TOKEN).
DOCUMENT_QA_ENABLED=1
DOCUMENT_MAX_BYTES=5242880
# Trần ký tự chữ tách từ TXT/DOCX đưa vào 1 lượt hỏi (~10k token).
DOCUMENT_MAX_CHARS=40000
# PDF dự phòng qua OpenRouter: chỉ nhận engine MIỄN PHÍ cloudflare-ai (mistral-ocr/
# native tính tiền bị coi như tắt); để trống = chỉ Gemini đọc PDF.
OPENROUTER_PDF_ENGINE=cloudflare-ai
# Đồng bộ kho rag/ lên GitHub (/ragxuly, "lưu vào kho"): token fine-grained chỉ repo này,
# Contents: write. Repo/branch trống = lấy RENDER_GIT_REPO_SLUG/RENDER_GIT_BRANCH.
GITHUB_RAG_TOKEN=
RAG_GITHUB_REPO=
RAG_GITHUB_BRANCH=

# Telegram media
MEDIA_DIR=media
TELEGRAM_CONNECT_TIMEOUT=30
TELEGRAM_READ_TIMEOUT=90
TELEGRAM_WRITE_TIMEOUT=90
TELEGRAM_POOL_TIMEOUT=30
TELEGRAM_MEDIA_RETRIES=3

# Telegram: phản hồi khi chờ câu trả lời, nút bấm, định dạng
# Lượt chat lâu hơn chừng này giây thì gửi 1 dòng "em đang tra web..." (0 = tắt).
TELEGRAM_STATUS_DELAY_SEC=7
# 👀 lên tin phải chờ lượt trước, xong đổi 👌 (lỗi 😢).
TELEGRAM_BUSY_REACTIONS=true
# Nút 👍/👎/🔄 Thử lại/✂️ Ngắn hơn dưới câu trả lời chat.
TELEGRAM_ANSWER_BUTTONS=true
# Hiện chữ đang sinh dần (bản nháp sendMessageDraft) cho lượt chat thường.
TELEGRAM_STREAM_DRAFTS=false
# Tin "rich" gốc của Telegram (tiêu đề, bảng, khối code); lỗi thì quay về HTML.
TELEGRAM_RICH_MESSAGES=false

# Zalo gateway
ZALO_ENABLED=false
ZALO_BRIDGE_SECRET=
ZALO_CONTROL_PORT=9901
# Chỉ cần đặt khi KHÔNG đăng nhập Zalo qua /zalo: job nền ưu tiên accountId
# trong session đã đăng nhập, rồi tới biến này, rồi tài khoản có nhiều nhóm nhất.
ZALO_BOT_ACCOUNT_ID=zalo-bot
ZALO_CONTROLLER_ID=
ZALO_COOKIE_JSON=
ZALO_IMEI=
ZALO_USER_AGENT=
ZALO_GROUP_REFRESH_MS=60000
ZALO_OUTBOX_POLL_MS=15000
ZALO_GROUP_RETENTION_DAYS=30
ZALO_DAILY_SUMMARY_HOUR=9
ZALO_IMAGE_MAX_BYTES=8388608
# Outbox: số lần thử 1 tin trước khi bỏ cuộc (báo chủ bot 1 lần).
ZALO_OUTBOX_MAX_ATTEMPTS=5
# Gateway: số tin riêng xử lý song song và số tin chờ tối đa của 1 người gửi.
# Đặt = số chỗ của thành viên (MAX_CONCURRENT_TURNS - OWNER_RESERVED_SLOTS, mặc định
# 1) để tin xếp hàng ở gateway (không timeout) thay vì chờ trong Python quá
# BRIDGE_TIMEOUT_MS (240s) rồi nhận câu báo lỗi.
ZALO_DIRECT_CONCURRENCY=1
ZALO_DIRECT_SENDER_BACKLOG=8
# Gộp tin chữ liên tiếp của 1 người thành 1 lượt AI: chờ ZALO_DIRECT_DEBOUNCE_MS
# sau tin cuối (0 = tắt chờ; tin gõ trong lúc lượt trước đang chạy vẫn được gộp),
# tối đa ..._MAX_MS tính từ tin đầu hoặc ..._MAX_MESSAGES tin.
ZALO_DIRECT_DEBOUNCE_MS=2000
ZALO_DIRECT_DEBOUNCE_MAX_MS=6000
ZALO_DIRECT_DEBOUNCE_MAX_MESSAGES=4
# Nghỉ ngẫu nhiên giữa các đoạn trả lời và giữa các tin outbox (0 và 0 = tắt).
ZALO_SEND_GAP_MIN_MS=600
ZALO_SEND_GAP_MAX_MS=1500
# Ngân sách tin outbox (nhắc việc, tóm tắt nhóm, xem trước bài FB) mỗi giờ của
# tài khoản B; vượt thì HOÃN sang lượt sau, không bỏ tin nào. 0 = không giới hạn.
ZALO_OUTBOX_MAX_PER_HOUR=60
# "Đang soạn tin", "đã xem" và reaction 👌 khi tin phải chờ lượt trước (0 = tắt).
ZALO_PRESENCE_EVENTS=1
# Ai được gọi /internal/zalo/* (gateway chạy cùng container -> loopback).
ZALO_BRIDGE_ALLOWED_HOSTS=127.0.0.1,::1
ZALO_BRIDGE_ALLOW_FORWARDED=0
# Gateway: URL bridge Python (trống = http://127.0.0.1:$PORT/internal/zalo), thư mục
# ghi ảnh QR đăng nhập (trống = thư mục chạy), heap Node (MB, scripts/run-zalo-gateway.sh),
# thời gian chờ gộp ảnh + caption cùng người gửi trong nhóm nguồn Facebook (ms).
ZALO_BRIDGE_BASE_URL=
ZALO_QR_OUTPUT_DIR=
ZALO_NODE_HEAP_MB=96
# --optimize-for-size cho node gateway (RSS ~86 -> ~75 MB lúc nạp zca-js; 0 = tắt) và
# cờ node thêm tuỳ ý (để trống).
ZALO_NODE_OPTIMIZE_SIZE=1
ZALO_NODE_EXTRA_FLAGS=
ZALO_FB_MERGE_WINDOW_MS=30000
# /zalopair, /zaloadmin lần đầu: xếp 1 lời chào (kèm vài câu thử) gửi tới người
# vừa được cấp quyền qua outbox Zalo. 0 = không gửi.
ZALO_WELCOME_ON_PAIR=1

# Backtest must stay disabled on the Render web process.
STOCK_BACKTEST_ALLOW_ON_RENDER=false
STOCK_BACKTEST_CONCURRENCY=4

# Zoom Team Chat (webhook + gửi tin + pairing)
ZOOM_ENABLED=false
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_BOT_JID=
ZOOM_SECRET_TOKEN=
ZOOM_VERIFICATION_TOKEN=
ZOOM_ACCOUNT_ID=

# Facebook Page publishing (Zalo -> duyệt -> đăng Facebook Page)
# Page mặc định ("default" trong /fb_themnhom):
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_VERSION=v26.0
# Page thứ 2 trở đi: thêm hậu tố _<page_key> (page_key tuỳ chọn, vd "2"):
# FACEBOOK_PAGE_ID_2=
# FACEBOOK_PAGE_ACCESS_TOKEN_2=
# Dùng /fb_pages để xem các page đã cấu hình; /fb_ok đăng lên MỌI page đủ 2 biến.
# Lọc bài nhóm Zalo trước hàng chờ (1 = bật): cần đủ ảnh + caption; bỏ bài chỉ báo
# mã giảm giá. Hàng chờ tối đa, số ngày chống trùng, số ngày giữ bài đã đăng/bỏ qua.
FACEBOOK_REQUIRE_PHOTO_AND_CAPTION=1
FACEBOOK_SKIP_VOUCHER_POSTS=1
FACEBOOK_MAX_PENDING=150
FACEBOOK_DEDUP_DAYS=7
FACEBOOK_HISTORY_DAYS=30
# Page RIÊNG cho báo cáo chứng khoán + tin CafeF (services/market_page.py, bỏ trống = tắt):
# FACEBOOK_PAGE_ID_MARKET=
# FACEBOOK_PAGE_ACCESS_TOKEN_MARKET=
MARKET_STOCK_TIMES_VN=15:20
MARKET_NEWS_TIMES_VN=08:30
# branded (ảnh bài CafeF + khung/logo) | none (đăng bản tin không ảnh).
MARKET_NEWS_IMAGE=branded
MARKET_CATCHUP_MIN=120
MARKET_RETRY_MIN=10
MARKET_MAX_ATTEMPTS=4
# VACUUM FULL bảng ảnh Facebook tối đa 1 lần/tuần khi an toàn (0 = tắt): thứ (0 = thứ 2
# ... 6 = Chủ nhật), giờ VN, lãng phí tối thiểu; DB_SIZE_LIMIT_MB cũng là mốc watchdog.
DB_AUTO_VACUUM_FULL=1
DB_VACUUM_WEEKDAY=6
DB_VACUUM_HOUR=3
DB_VACUUM_MIN_WASTE_MB=50
DB_SIZE_LIMIT_MB=500

# Độ bền runtime (đều có mặc định an toàn)
# Hạn chót tổng 1 lượt trả lời (phải < 240s gateway Zalo chờ).
CHAT_TURN_TIMEOUT_SEC=200
# Trích trí nhớ nền (theo lô, không còn sau MỖI tin) - hạn chót mỗi lượt; /ragxuly dọn file dài (trần tổng).
MEMORY_UPDATE_TIMEOUT_SEC=90
# Trích trí nhớ khi có >= N lượt chưa xử lý (bỏ qua "ok", "cảm ơn"...), hoặc rảnh
# MEMORY_IDLE_FLUSH_SEC giây (vòng quét nền mỗi MEMORY_SWEEP_SEC; MEMORY_SWEEP_ENABLED=0 tắt).
MEMORY_FLUSH_EXCHANGES=3
MEMORY_IDLE_FLUSH_SEC=1800
MEMORY_SWEEP_SEC=600
MEMORY_SWEEP_ENABLED=1
# Gộp fact trùng nghĩa tối đa 1 lần/ngày/người khi gần đầy (>= 80% trần 40); 0 = tắt.
MEMORY_CONSOLIDATION=1
# "Cách trả lời" bộ trích nhớ tự rút ra phải được người dùng duyệt ([Ghi nhớ]/[Bỏ],
# "ghi nhớ"/"bỏ", /hoc ok|bo) mới áp; câu người dùng tự dặn rõ vẫn áp ngay. 0 = áp ngay như cũ.
STYLE_RULES_NEED_APPROVAL=1
# Che OTP/mật khẩu/STK/CCCD/số thẻ/API key trong prompt trước khi gửi provider AI
# (DB vẫn lưu nguyên văn). 0 = tắt.
PROMPT_REDACTION=1
RAG_CLEAN_TOTAL_TIMEOUT_SEC=900
# Ngân sách prompt (ký tự) gửi provider: tổng / từng tin lịch sử / grounding / trí nhớ.
PROMPT_BUDGET_CHARS=40000
HISTORY_MESSAGE_MAX_CHARS=1500
GROUNDING_MAX_CHARS=9000
MEMORY_MAX_CHARS=3000
# Trần lịch sử riêng cho Groq (gpt-oss-20b free ~8K token/phút).
GROQ_HISTORY_MAX_CHARS=3500
# Bảo mật DB/secret: SSL verify-full cần CA Supabase (DATABASE_SSL_CA=/path/prod-ca.crt);
# xoay khoá Fernet: khoá mới vào SETTINGS_ENC_KEY, khoá cũ vào SETTINGS_ENC_KEY_OLD.
DATABASE_SSL_MODE=require
# DATABASE_SSL_CA=
# SETTINGS_ENC_KEY_OLD=
SETTINGS_REJECT_PLAINTEXT=0
# Cảnh báo danh mục cuối phiên (15h05 giờ VN): chạm stop/target, breakout Donchian.
ENABLE_PORTFOLIO_ALERTS=true
# Sổ giao dịch (/bancp kèm giá, /laicp): phí CTCK mỗi chiều và thuế TNCN khi bán (tỷ lệ).
STOCK_FEE_RATE=0.0015
STOCK_SELL_TAX_RATE=0.001
# Job danh mục hằng ngày (mọi người dùng): lưu quy đổi sự kiện quyền đã được giá xác nhận.
PORTFOLIO_EVENTS_ENABLED=1
PORTFOLIO_EVENTS_HOUR_VN=8
PORTFOLIO_EVENTS_MAX_HOLDINGS=60
# Báo trước lịch sự kiện quyền (cổ tức, quyền mua, ĐHCĐ) của mã đang giữ, tối đa N mã tra lịch/ngày.
PORTFOLIO_EVENT_NOTICES=1
PORTFOLIO_EVENTS_MAX_SYMBOLS=40
# Tin danh mục chủ động gửi thành viên Zalo qua outbox: tối đa N tin/người/ngày (0 = tắt).
PORTFOLIO_PUSH_ZALO_DAILY_CAP=5
# Cảnh báo giá trong phiên (ngưỡng người dùng tự đặt + stop/target danh mục chủ bot),
# chỉ quét giờ giao dịch bằng tick hôm nay. Đặt 0 để tắt từng phần.
PRICE_ALERTS_ENABLED=1
PRICE_ALERTS_HOLDINGS_INTRADAY=1
PRICE_ALERT_POLL_SEC=300
PRICE_ALERT_MAX_SYMBOLS=40
PRICE_ALERT_MAX_PER_USER=10
WATCHLIST_MAX_SYMBOLS=20
# Trần tổng dung lượng ảnh Facebook đang lưu (MB) cho 1 tài khoản.
FACEBOOK_MAX_MEDIA_MB=150
# Ngày nghỉ giao dịch bổ sung (YYYY-MM-DD, phẩy) ngoài bảng trong stock/calendar.py.
# STOCK_EXTRA_HOLIDAYS=
# Tham số policy cổ phiếu (mặc định stock/policy_params.json).
# STOCK_POLICY_PARAMS_PATH=
GROQ_TOTAL_TIMEOUT_SEC=90
OPENROUTER_TOTAL_TIMEOUT_SEC=90
# Trần byte tải về cho 1 trang/feed.
WEB_READER_MAX_BYTES=2097152
# Webhook Telegram/Zoom lỗi: thử tối đa N lần rồi chuyển DEAD + báo chủ bot.
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_DEAD_RETENTION_DAYS=14
# Tổng số lượt AI chạy song song (mọi người dùng, mọi kênh) - giữ RAM dưới 512 MB.
MAX_CONCURRENT_TURNS=2
# Chỗ dành riêng cho chủ bot (Telegram/Zoom/web) trong MAX_CONCURRENT_TURNS: mọi
# lượt Zalo (kể cả admin, Zalo của chủ bot) dùng chung MAX - N chỗ còn lại nên chủ bot
# không phải chờ 2 thành viên. 0 = tắt; MAX_CONCURRENT_TURNS=1 thì tự tắt.
OWNER_RESERVED_SLOTS=1
# Giới hạn mỗi ngày của thành viên Zalo (role user; chủ bot, admin không bị giới
# hạn), mở lại 0h giờ VN, 0 = không giới hạn. Lượt nặng = /anh, /*_chitiet, chat có
# tra web (hết thì vẫn trò chuyện được nhưng không tra web). Sửa được trên /admin.
ZALO_MEMBER_DAILY_TURNS=40
ZALO_MEMBER_DAILY_HEAVY=5
# Tổng MB body lớn (ảnh, bài Facebook) được xử lý cùng lúc.
REQUEST_HEAVY_BUDGET_MB=30
# Dọn dữ liệu cũ hằng ngày (số ngày giữ; 0 = tắt).
RETENTION_USER_CALLS_DAYS=180
RETENTION_PROVIDER_CALLS_DAYS=180
RETENTION_ZALO_OUTBOX_DAYS=30
RETENTION_REMINDERS_DAYS=90
# Ghi chú theo phiên (trí nhớ hội thoại) và sự kiện hỏi thăm chủ động đã qua.
RETENTION_SESSION_NOTES_DAYS=365
RETENTION_USER_EVENTS_DAYS=90
# Đánh giá 👍/👎 câu trả lời (kèm bản chụp câu hỏi/câu trả lời).
RETENTION_ANSWER_FEEDBACK_DAYS=180
# Số đo từng lượt trả lời (bảng turn_metrics: chờ khoá/slot, ngữ cảnh, LLM, gửi).
RETENTION_TURN_METRICS_DAYS=14
# Tin gom đã gửi/đã bỏ (bảng notify_queue) - giữ vài ngày để chống xếp trùng.
RETENTION_NOTIFY_QUEUE_DAYS=7
# Việc nền đã xong (bảng bg_jobs: yêu cầu + kết quả có trần).
RETENTION_BG_JOBS_DAYS=30

# ─── Quota miễn phí từng provider (services/quota_burn.py, /admin → Thống kê AI) ───
# Cảnh báo chủ bot khi đã dùng >= N% hạn mức trong cửa sổ quota (0 = tắt), tối đa
# 1 lần/provider/cửa sổ. Hạn mức 0 = chưa đặt -> chỉ hiển thị, không cảnh báo.
QUOTA_BURN_ALERT_PCT=80
# Gemini: hạn mức tính theo PROJECT Google Cloud (không theo key), reset 0h giờ Thái
# Bình Dương. 2 key api1/api2 cùng 1 project -> 1 để cộng chung. Số lượt/ngày của
# model đang dùng xem trên AI Studio (thay đổi theo model và theo thời gian).
GEMINI_KEYS_SAME_PROJECT=0
FREE_TIER_RPD_GEMINI=0
# Gemini Live (live_api1 + live_api2): Google chưa công bố hạn mức free tier - để 0
# (chỉ hiển thị số lượt) cho tới khi thấy số thật ở aistudio.google.com/rate-limit.
FREE_TIER_RPD_GEMINI_LIVE=0
# Groq: số còn lại lấy chính xác từ header x-ratelimit-* của response; số dưới chỉ
# dùng khi chưa có header.
FREE_TIER_RPD_GROQ=0
# OpenRouter model :free: 50 lượt/ngày khi chưa từng nạp 10 USD, 1000 khi đã nạp.
FREE_TIER_RPD_OPENROUTER=50
# Tavily gói free: 1000 credit/tháng (tìm "advanced" tốn 2 credit).
FREE_TIER_TAVILY_MONTHLY=1000
# Groq: xin token trong stream (stream_options.include_usage) cho thống kê; 0 = tắt.
GROQ_STREAM_USAGE=1

# ─── Cảnh báo chủ bot, watchdog, sao lưu (đều có mặc định an toàn) ───
# Zoom làm kênh phụ cho cảnh báo: critical (Telegram lỗi + mọi cảnh báo 🚨),
# fallback (chỉ khi Telegram lỗi), all, off.
ALERT_ZOOM_MIRROR=critical
# Watchdog luật cố định (services/watchdog.py): RAM, dung lượng DB (dùng
# DB_SIZE_LIMIT_MB), inbox ứ đọng, job hằng ngày quá hạn, nhịp tim/khởi động lại.
WATCHDOG_ENABLED=1
# Ngưỡng % RAM working set (không tính page cache), 2 lần đo liên tiếp.
WATCHDOG_MEMORY_PCT=85
# Tin Telegram/Zoom tới hạn quá N phút mà worker chưa nhận.
WATCHDOG_INBOX_STALE_MIN=10
# Báo khi khởi động lại sau gián đoạn > N phút; báo khi restart (không deploy,
# instance trước không tắt êm - sửa env/Restart service không tính) >= N lần/24 giờ.
WATCHDOG_RESTART_GAP_MIN=20
WATCHDOG_RESTART_BURST=3
# Gom lỗi theo loại + vị trí code (không lưu nội dung lỗi), lệnh /loi.
ERROR_DIGEST_ENABLED=1
# Báo ngay khi có loại lỗi MỚI trong ngày, tối đa N tin/giờ.
ERROR_ALERT_IMMEDIATE=1
ERROR_ALERT_MAX_PER_HOUR=4
# Giờ (VN) gửi tổng hợp lỗi của hôm qua; -1 = tắt.
ERROR_DIGEST_HOUR_VN=7
# Sao lưu DB chạy trên GitHub Actions (.github/workflows/backup.yml, secret
# BACKUP_DATABASE_URL + BACKUP_PASSPHRASE đặt trên GitHub, KHÔNG đặt ở đây - xem
# docs/backup-restore.md). Bot báo khi bản mới nhất quá N ngày (0 = tắt).
BACKUP_STALE_DAYS=3
# Có SETTINGS_ENC_KEY_OLD: lúc khởi động tự mã hoá lại giá trị còn ở khoá cũ
# (compare-and-swap) rồi báo số còn lại; 0 = chỉ báo, xoay bằng nút trên /admin.
SETTINGS_AUTO_ROTATE=1

# ─── Đánh giá golden set tier B (CHỈ chạy local/GitHub Actions, KHÔNG đặt trên Render) ───
# RUN_LIVE_EVALS=1 mới gọi provider thật (scripts/run_evals.py, pytest -m live_llm);
# trần tổng lượt gọi; EVAL_JUDGE=1 bật giám khảo LLM (chỉ tham khảo) trong pytest;
# giám khảo ghim provider/model (đổi khi model free bị khai tử).
# RUN_LIVE_EVALS=
# EVAL_MAX_CALLS=120
# EVAL_JUDGE=
# EVAL_JUDGE_PROVIDER=groq
# EVAL_JUDGE_MODEL=openai/gpt-oss-120b
